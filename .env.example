# ============================================================================
# Local development environment TEMPLATE — copy to .env and fill in real
# values. This file is COMMITTED TO GIT, so it must contain no secrets and
# no tenant-specific identifiers.
#
# Production runtime values must live in Azure Key Vault and be loaded by
# the Function App at startup; never bake them into source.
# ============================================================================

# ---- Azure tenant -----------------------------------------------------------
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# ---- Bot Framework / Teams --------------------------------------------------
# From the Bot Framework AAD app reg → Certificates & secrets
MICROSOFT_APP_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_APP_PASSWORD=<paste-bot-client-secret>
MICROSOFT_APP_TENANT_ID=00000000-0000-0000-0000-000000000000
# Must match the Bot app reg's `signInAudience`:
#   AzureADMyOrg            → SingleTenant
#   AzureADMultipleOrgs     → MultiTenant
#   AzureADandPersonalMicrosoftAccount → MultiTenant
MICROSOFT_APP_TYPE=SingleTenant

# ---- Ingestion API (bot → ingestion auth) -----------------------------------
INGESTION_APP_ID=00000000-0000-0000-0000-000000000000
INGESTION_BASE_URL=http://localhost:7071
INGESTION_SCOPE=api://<INGESTION_APP_ID>/.default
# Audience the Ingestion API validates against (no trailing /.default)
EXPECTED_AUDIENCE=api://<INGESTION_APP_ID>
# CSV list of roles the bot's token must carry (default Documents.Ingest)
EXPECTED_ROLES=Documents.Ingest

# ---- SharePoint -------------------------------------------------------------
SHAREPOINT_SITE_HOSTNAME=<tenant>.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/BCR-Ledger
SHAREPOINT_DRIVE_NAME=Documents
SHAREPOINT_ROOT_FOLDER=

# ---- Client identity (per-client deployment) --------------------------------
# Lets Claude decide invoice direction (sales vs purchase) by matching parties.
CLIENT_COMPANY_NAME=
CLIENT_NIP=

# ---- Claude (Anthropic) content classification ------------------------------
ANTHROPIC_ENABLED=true
# Stored in Key Vault in Azure; set directly only for local development.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Hard cap on bytes sent to the model (default 10 MiB).
ANTHROPIC_MAX_CONTENT_BYTES=10485760
# Below this confidence the document is routed to 98_Nieposortowane (0.70-0.95).
CLASSIFICATION_ACCEPT_THRESHOLD=0.70

# ---- The document index (PostgreSQL, Entra auth only) ---------------------
# off: nothing written. write: every filed document gets a client-scoped row.
LEDGER_INDEX_MODE=off
# <server>.postgres.database.azure.com; the password is an Entra token.
LEDGER_DB_HOST=
LEDGER_DB_NAME=ledger
# The login of the identity that connects (the Function App's name in Azure).
LEDGER_DB_USER=

# ---- Telemetry --------------------------------------------------------------
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ---- Misc -------------------------------------------------------------------
LOG_LEVEL=info
NODE_ENV=development
