# ============================================================================
# Local development environment template — copy to .env and fill in values.
# Never commit .env files. Production secrets must live in Azure Key Vault.
# ============================================================================

# ---- Azure tenant -----------------------------------------------------------
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# ---- Bot Framework / Teams --------------------------------------------------
# From the Azure Bot resource → Configuration blade
MICROSOFT_APP_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_APP_PASSWORD=
MICROSOFT_APP_TENANT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_APP_TYPE=MultiTenant

# ---- Ingestion API (bot → ingestion auth) -----------------------------------
INGESTION_APP_ID=00000000-0000-0000-0000-000000000000
INGESTION_BASE_URL=http://localhost:7071
INGESTION_SCOPE=api://00000000-0000-0000-0000-000000000000/.default

# ---- SharePoint -------------------------------------------------------------
SHAREPOINT_SITE_HOSTNAME=contoso.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/BCR-Ledger
SHAREPOINT_DRIVE_NAME=Documents
SHAREPOINT_ROOT_FOLDER=

# ---- Azure AI Document Intelligence (optional) ------------------------------
DOCUMENT_INTELLIGENCE_ENDPOINT=https://<region>.api.cognitive.microsoft.com
DOCUMENT_INTELLIGENCE_KEY=
DOCUMENT_INTELLIGENCE_ENABLED=false

# ---- Telemetry --------------------------------------------------------------
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ---- Misc -------------------------------------------------------------------
LOG_LEVEL=info
NODE_ENV=development
