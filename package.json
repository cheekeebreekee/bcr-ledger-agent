{
  "name": "bcr-ledger-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Microsoft Teams AI Agent that files document attachments into SharePoint",
  "license": "UNLICENSED",
  "packageManager": "yarn@4.3.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "yarn workspaces foreach -A -pt run build",
    "test": "yarn workspaces foreach -A -p run test",
    "test:coverage": "yarn workspaces foreach -A -p run test:coverage",
    "test:tools": "node --test \"tools/**/*.test.mjs\"",
    "check:app-settings": "node tools/check-app-settings.mjs",
    "lint": "eslint \"packages/**/src/**/*.ts\"",
    "format": "prettier --write \"packages/**/src/**/*.{ts,json}\" \"infrastructure/**/*.bicep\"",
    "type-check": "yarn workspaces foreach -A -p run type-check",
    "clean": "yarn workspaces foreach -A -p run clean",
    "start:bot": "yarn workspace @bcr/teams-bot start",
    "start:ingestion": "yarn workspace @bcr/document-ingestion start",
    "deploy:dev": "./infrastructure/deploy.sh dev",
    "deploy:prod": "./infrastructure/deploy.sh prod"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^22.5.0",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "eslint": "^9.9.1",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.5",
    "typescript": "^5.5.4"
  }
}
