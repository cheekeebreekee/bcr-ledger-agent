{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "version": "0.1.5",
  "id": "REPLACE-WITH-BOT-APP-ID",
  "developer": {
    "name": "BCR Platform",
    "websiteUrl": "https://www.bcr-group.pl/",
    "privacyUrl": "https://www.bcr-group.pl/privacy",
    "termsOfUseUrl": "https://www.bcr-group.pl/terms"
  },
  "name": {
    "short": "Asystent BCR",
    "full": "Asystent Archiwizacji Dokumentów BCR"
  },
  "description": {
    "short": "Automatycznie archiwizuje dokumenty (faktury, umowy, raporty) w SharePoint.",
    "full": "Wyślij mi w czacie dokument (fakturę, paragon, umowę, wyciąg bankowy, raport lub deklarację), a ja przeanalizuję jego treść, rozpoznam typ i datę, a następnie umieszczę go w odpowiednim folderze w SharePoint. Klasyfikacja odbywa się na podstawie zawartości dokumentu — nazwa pliku nie ma znaczenia. Dokumenty, których nie uda się jednoznacznie rozpoznać, trafiają do folderu do ręcznej weryfikacji."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#0078D4",
  "bots": [
    {
      "botId": "REPLACE-WITH-BOT-APP-ID",
      "scopes": ["personal", "team", "groupchat"],
      "supportsFiles": true,
      "isNotificationOnly": false,
      "commandLists": [
        {
          "scopes": ["personal", "team", "groupchat"],
          "commands": [
            { "title": "pomoc", "description": "Pokaż jak działa archiwizacja dokumentów" }
          ]
        }
      ]
    }
  ],
  "staticTabs": [
    {
      "entityId": "myDocs",
      "name": "Moje dokumenty",
      "contentUrl": "https://func-bcr-bot-dev-vyyintffz6ehq.azurewebsites.net/api/mydocs?userObjectId={userObjectId}&theme={theme}",
      "websiteUrl": "https://bcrgroupeu.sharepoint.com",
      "scopes": ["personal"]
    }
  ],
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": ["*.sharepoint.com", "*.azurewebsites.net"]
}
