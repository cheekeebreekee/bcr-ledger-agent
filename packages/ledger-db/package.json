{
  "name": "@bcr/ledger-db",
  "version": "0.1.0",
  "private": true,
  "description": "The document index: a PostgreSQL pool authenticated with Entra tokens, the one client-scoped transaction, repositories and migrations",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "test:db": "jest --config jest.db.config.js --runInBand",
    "type-check": "tsc --noEmit && tsc --noEmit -p itest/tsconfig.json",
    "migrate": "tsc -b && node dist/cli/migrate.js"
  },
  "dependencies": {
    "@azure/identity": "^4.4.1",
    "@bcr/shared": "workspace:*",
    "pg": "^8.16.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.15.4",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.5.4"
  }
}
