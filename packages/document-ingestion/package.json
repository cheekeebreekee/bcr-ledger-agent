{
  "name": "@bcr/document-ingestion",
  "version": "0.1.0",
  "private": true,
  "description": "Azure Functions API that classifies documents and uploads them to SharePoint via Microsoft Graph",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist",
    "prestart": "yarn build",
    "start": "func start --typescript --port 7071",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "type-check": "tsc --noEmit",
    "eval": "tsc -b && node dist/evaluation/main.js run",
    "eval:truth": "tsc -b && node dist/evaluation/main.js truth",
    "eval:search": "tsc -b && node dist/evaluation/main.js search",
    "package": "rimraf ../../artifacts/document-ingestion.zip dist tsconfig.tsbuildinfo ../shared/dist ../shared/tsconfig.tsbuildinfo ../ledger-db/dist ../ledger-db/tsconfig.tsbuildinfo && yarn build && node ../../tools/package-function.mjs document-ingestion"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.2",
    "@azure/data-tables": "^13.3.2",
    "@azure/functions": "^4.5.0",
    "@azure/identity": "^4.4.1",
    "@azure/keyvault-secrets": "^4.8.0",
    "@bcr/ledger-db": "workspace:*",
    "@bcr/shared": "workspace:*",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "applicationinsights": "^3.3.0",
    "jose": "^5.8.0",
    "pdf-lib": "^1.17.1",
    "undici": "^6.19.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^22.5.0",
    "azure-functions-core-tools": "^4.3.0",
    "jest": "^29.7.0",
    "pg": "^8.16.3",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.5.4"
  }
}
