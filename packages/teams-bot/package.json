{
  "name": "@bcr/teams-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Microsoft Teams bot hosted in Azure Functions — receives chat activities and forwards documents to the ingestion API",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist",
    "prestart": "yarn build",
    "start": "func start --typescript",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "type-check": "tsc --noEmit",
    "package": "yarn build && zip -r ../../artifacts/teams-bot.zip dist host.json package.json node_modules"
  },
  "dependencies": {
    "@azure/functions": "^4.5.0",
    "@azure/identity": "^4.4.1",
    "@azure/msal-node": "^2.13.0",
    "@bcr/shared": "workspace:*",
    "applicationinsights": "^3.3.0",
    "botbuilder": "^4.23.1",
    "botbuilder-core": "^4.23.1",
    "botframework-connector": "^4.23.1",
    "undici": "^6.19.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^22.5.0",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.5.4"
  }
}
